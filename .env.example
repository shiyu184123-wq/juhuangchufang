# Neon 托管 Postgres（Vercel + Neon）。连接串必须带 ?sslmode=require。
# Neon 控制台 → Connection Details 可复制；推荐直接用 Pooled connection（-pooler）。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# 线上必须重新生成，不要复用本地值：`node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""

# Bangumi OAuth（在 Bangumi 应用后台注册后获得，只放服务端，不要出现在客户端代码里）
# 回调地址必须与后台登记完全一致；localhost 与 127.0.0.1 在 Bangumi 侧算两个不同地址。
# 线上回调：https://<vercel 域名>/api/auth/callback/bangumi（部署后在 Bangumi 后台登记）。
# 本地开发仍保留 http://localhost:3000/...（Bangumi 后台只能登记一个地址，本地与线上切换时改后台）。
BANGUMI_CLIENT_ID=""
BANGUMI_CLIENT_SECRET=""
BANGUMI_REDIRECT_URI="http://localhost:3000/api/auth/callback/bangumi"

# Resend（验证码邮件）。测试模式 onboarding@resend.dev 只能发给注册 Resend 的邮箱；
# 要让「任何人」收到码，必须在 Resend 验证自有域名并改 OTP_FROM。
RESEND_API_KEY=""
OTP_FROM="剧荒处方 <onboarding@resend.dev>"