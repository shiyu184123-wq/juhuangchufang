DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET=""

# Bangumi OAuth（在 Bangumi 应用后台注册后获得，只放服务端，不要出现在客户端代码里）
# 回调地址必须与后台登记完全一致；localhost 与 127.0.0.1 在 Bangumi 侧算两个不同地址。
BANGUMI_CLIENT_ID=""
BANGUMI_CLIENT_SECRET=""
BANGUMI_REDIRECT_URI="http://localhost:3000/api/auth/callback/bangumi"

# Resend（验证码邮件）。测试域名 onboarding@resend.dev 只能发给自己的注册邮箱。
RESEND_API_KEY=""
OTP_FROM="剧荒处方 <onboarding@resend.dev>"